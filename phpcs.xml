<?xml version="1.0"?>
<ruleset name="Crosspost to Pixelfed">
	<description>PHPCS rules for the Crosspost to Pixelfed plugin.</description>

	<file>.</file>

	<!-- Only lint PHP files; JS and CSS use their own linters (eslint / stylelint). -->
	<exclude-pattern>*/assets/*.js</exclude-pattern>
	<exclude-pattern>*/assets/*.css</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress"/>

	<!-- Enforce the correct text domain for i18n checks. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="crosspost-to-pixelfed"/>
		</properties>
	</rule>

	<!-- Minimum supported WordPress and PHP versions. -->
	<config name="minimum_supported_wp_version" value="5.8"/>
	<config name="testVersion" value="8.0-"/>
</ruleset>
